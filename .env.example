# SEVERANCE Environment Variables Template

SEVERANCE_ENV=development
SEVERANCE_SECRET_KEY=change-this-in-production-to-a-secure-random-token
SEVERANCE_ADMIN_ID=admin-001
SEVERANCE_ADMIN_PASSWORD=InitialAdminPassword123!
SEVERANCE_BOOTSTRAP_CODE=mrpl-sih-2026-bootstrap-key
SEVERANCE_DB_PATH=severance.db

# Agent Backend: 'ollama' (local sovereign, compliance requirement -- no document
# content may leave this machine), 'mock' (canned offline), or 'adk' (Google ADK)
AGENT_BACKEND=ollama
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=granite4.1:3b
# Second locally-installed model tried, still fully locally, only if the
# primary model returns zero citations. Set to "" to disable.
OLLAMA_FALLBACK_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=granite3.2-vision

# NOTE: there is intentionally no cloud LLM fallback (no Groq, no NVIDIA NIM).
# Document and question content must never leave this machine -- see
# agents/real.py's module docstring.

# Short per-person conversation memory: how many of the last Q&A turns are
# fed back into intent classification/drafting as context (never as a
# citation source). Keep this small -- each extra turn is more prompt text
# the local model re-reads on every call.
CONVERSATION_MEMORY_TURNS=2
